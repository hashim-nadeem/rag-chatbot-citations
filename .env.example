# Google AI Studio — https://aistudio.google.com/apikey (free, no card)
GOOGLE_GENERATIVE_AI_API_KEY=

# Provider switch: "google" (deployed) | "ollama" (fully local)
LLM_PROVIDER=google

# Model ids. VERIFY THESE IN YOUR CONSOLE — they get retired, and the free-tier
# daily caps differ wildly between them.
#   - text-embedding-004 and gemini-2.5-flash both 404 for new keys as of 2026-09.
#   - gemini-3.6-flash allows only 20 generate requests PER DAY on the free tier,
#     which is fewer than `npm run eval` needs (25). Read the QuotaFailure detail
#     on a 429 to see the real limit rather than assuming it is per-minute.
GOOGLE_EMBED_MODEL=gemini-embedding-001
GOOGLE_CHAT_MODEL=gemini-3.5-flash-lite
# Gemini 3 charges reasoning tokens against maxOutputTokens. Set empty to omit the
# field for a model that rejects it.
GOOGLE_THINKING_LEVEL=low
# gemini-embedding-001 defaults to 3072 dims; 768 keeps vectors.json near 6 MB.
GOOGLE_EMBED_DIMS=768

# Embedding build pacing. The free tier caps tokens AND requests per minute,
# and counts every item of a batch request. Raise both on a paid key.
EMBED_BATCH=50
EMBED_PACE_MS=25000

# Ollama, only when LLM_PROVIDER=ollama. Re-run `npm run embed` after switching:
# vectors are only comparable to queries from the same embedding model.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Retrieval threshold. See the sweep table in evals/RESULTS.md before changing.
SIMILARITY_FLOOR=0.68

# Upstash Redis — https://console.upstash.com (optional; app runs without it)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# The GitHub link in the header
NEXT_PUBLIC_REPO_URL=
